# Optional backend URL for local development. On a physical phone, use your laptop LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:4000

# Optional native Google Maps key for Android/iOS development or standalone builds.
# Restrict this key by Android package/SHA-1 or iOS bundle identifier and enable only Maps SDKs.
# Do not commit a real key.
GOOGLE_MAPS_API_KEY=
