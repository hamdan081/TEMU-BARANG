{
  "expo": {
    "name": "TemuBarang",
    "slug": "temukampus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "temukampus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TemuBarang menggunakan lokasi saat aplikasi dipakai untuk menandai lokasi barang hilang atau ditemukan dan menampilkan peta laporan."
        }
      ],
      "react-native-maps",
      [
        "expo-sensors",
        {
          "motionPermission": "TemuBarang menggunakan sensor gerak untuk mendeteksi pergeseran perangkat saat fitur Pengaman Meja diaktifkan."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
